#!/usr/bin/env python3
"""Pre-push secret guard: refuse a push whose new commits add a credential-looking file name
(.env, *token*, *.key, *.pem, id_rsa, credentials) or content (private keys, GitHub, AWS and
Slack tokens, JWTs, password/secret/token assignments). Enable once per clone:
    git config core.hooksPath .githooks"""

import re
import subprocess
import sys

ZERO = "0" * 40
BAD_NAME = re.compile(
    r"(^|/)(\.env(\..*)?|[^/]*token[^/]*|[^/]*\.key|[^/]*\.pem|[^/]*\.p12|id_(rsa|ed25519|ecdsa)[^/]*"
    r"|[^/]*credential[^/]*|\.pgpass|\.netrc)$",
    re.IGNORECASE,
)
BAD_TEXT = re.compile(
    rb"-----BEGIN [A-Z ]*PRIVATE KEY-----"
    rb"|\bgh[pousr]_[A-Za-z0-9]{36,}"
    rb"|\bgithub_pat_[A-Za-z0-9_]{40,}"
    rb"|\bAKIA[0-9A-Z]{16}\b"
    rb"|\bxox[abprs]-[A-Za-z0-9-]{10,}"
    rb"|\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}"
    rb"|(?i:(password|passwd|secret|api_?key|access_?token|totp|pin)\s*[=:]\s*['\"]?[A-Za-z0-9/+_.-]{8,})"
)


def git(*args: str) -> bytes:
    return subprocess.run(["git", *args], check=True, capture_output=True).stdout


def commits(local: str, remote: str) -> list[str]:
    span = [local, "--not", "--remotes"] if remote == ZERO else [f"{remote}..{local}"]
    return git("rev-list", *span).decode().split()


def problems(commit: str) -> list[str]:
    out = []
    names = git("diff-tree", "-r", "--root", "--no-commit-id", "--name-only", "--diff-filter=AMR", commit)
    for name in names.decode().splitlines():
        if BAD_NAME.search(name):
            out.append(f"{commit[:8]} {name}: file name looks like a credential")
            continue
        match = BAD_TEXT.search(git("show", f"{commit}:{name}"))
        if match:
            out.append(f"{commit[:8]} {name}: content matches a secret pattern")
    return out


def main() -> int:
    found = []
    for line in sys.stdin:
        local_ref, local, remote_ref, remote = line.split()
        if local != ZERO:
            for commit in commits(local, remote):
                found += problems(commit)
    if found:
        print("pre-push secret guard: push refused", *found, sep="\n  ", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
